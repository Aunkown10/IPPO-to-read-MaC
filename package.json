{
  "name": "ippo-to-read",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && vite",
    "build": "node scripts/copy-pdf-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:native": "cargo test -p ippo-core",
    "check:native": "cargo check -p ippo-desktop",
    "test:classification:types": "tsc -p tests/tsconfig.classification.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
